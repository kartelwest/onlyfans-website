# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude admin chat assistant + PDF/image importer + Amplia content)
# Get a key at https://console.anthropic.com/
# NEVER commit the real value — this file only documents the variable name.
ANTHROPIC_API_KEY=

# Meta / Instagram Graph API (live publishing requires Business Verification + App Review)
META_APP_ID=
META_APP_SECRET=

# X / Twitter API (feature-flagged OFF by default; credentials only needed if owner enables live X)
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# Encryption key for social-account access/refresh tokens (256-bit key as hex, or a long passphrase)
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Video editor (MVP)
SUPABASE_VIDEO_ORIGINAIS_BUCKET=video-originals
SUPABASE_VIDEO_EDITADOS_BUCKET=video-edited
VIDEO_WORKER_API_KEY=
VIDEO_MAX_FILE_SIZE_MB=2048
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_WORKER_CONCURRENCY=2
VIDEO_WORKER_POLL_INTERVAL_MS=15000

# Optional: Google Drive webhook
GOOGLE_DRIVE_WATCH_CHANNEL_ID=
GOOGLE_DRIVE_WEBHOOK_SECRET=

# Optional: OpenAI Whisper API (otherwise worker tries local Whisper if installed)
OPENAI_API_KEY=

# Optional: ElevenLabs voiceover
ELEVENLABS_API_KEY=
