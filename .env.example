# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude admin chat assistant + PDF/image importer + Amplia content)
# Get a key at https://console.anthropic.com/
# NEVER commit the real value — this file only documents the variable name.
ANTHROPIC_API_KEY=

# Meta / Instagram Graph API (live publishing requires Business Verification + App Review)
META_APP_ID=
META_APP_SECRET=

# X / Twitter API (feature-flagged OFF by default; credentials only needed if owner enables live X)
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# Encryption key for social-account access/refresh tokens (256-bit key as hex, or a long passphrase)
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Shared secret for the daily ledger-deduction cron (vercel.json).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`; without it the
# endpoint refuses every request.
CRON_SECRET=

# Nightly database backup (/api/cron/database-backup).
# 256-bit key as 64 hex characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STORE THIS SOMEWHERE OTHER THAN GOOGLE DRIVE. It is the only thing that can
# read the backups, and a copy kept beside them protects nothing. Without it
# the backup job refuses to run rather than writing personal data unencrypted.
BACKUP_ENCRYPTION_KEY=

# Google Drive folder that receives the nightly backup. Share it with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor — service accounts see nothing
# that has not been shared with them. Without this the job still writes to
# Supabase Storage and reports Drive as skipped.
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
